<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://aqpgo.com/orquestador" targetNamespace="http://aqpgo.com/orquestador" elementFormDefault="qualified">

    <xs:element name="reservarYPagarRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="usuarioId" type="xs:string"/>
                <xs:element name="paqueteId" type="xs:string"/>
                <xs:element name="fechaSalida" type="xs:string"/>
                <xs:element name="numPersonas" type="xs:int"/>
                <xs:element name="monto" type="xs:string"/>
                <xs:element name="metodo" type="xs:string"/>
                <xs:element name="referencia" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="reservarYPagarResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reservaId" type="xs:string"/>
                <xs:element name="estadoReserva" type="xs:string"/>
                <xs:element name="pagoId" type="xs:string"/>
                <xs:element name="estadoPago" type="xs:string"/>
                <xs:element name="mensaje" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>